rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's planner data: only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Trial and subscription records: the owner can read; only Tafel's server functions can write.
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Public price feed: anyone can read; nobody writes from the app.
    match /prices/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
