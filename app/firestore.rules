rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can only read and write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Public price feed: anyone can read; only you update it (from the Firebase console or admin tools).
    match /prices/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
